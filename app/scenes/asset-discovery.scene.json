      "durationMs": 1400
    },
    {
      "id": "correlate",
      "kind": "correlate",
      "label": "Cross-referencing candidates against the conservative mandate in PortfolioAtlas",
      "durationMs": 1300
    },
    {
      "id": "synthesize",
      "kind": "synthesize",
      "label": "Weighing yield against risk concentration and audit status",
      "confidence": 0.74,
      "durationMs": 1600
    },
    {
      "id": "verify",
      "kind": "verify",
      "label": "Confirming NordBond as a reference point below threshold and flagging Aldergate's pending audit",
      "confidence": 0.81,
      "durationMs": 1000
    }
  ],
  "data": {
