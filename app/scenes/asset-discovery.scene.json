    "aldergate-estates-series": { "$ref": "aldergate-estates-yield-volatility-90d" },
    "vantara-metals-series": { "$ref": "vantara-metals-yield-volatility-90d" },
    "helios-yield-fund-series": { "$ref": "helios-yield-fund-yield-volatility-90d" },
