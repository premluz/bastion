    {
      "id": "search",
      "kind": "search",
      "label": "Scanning listed assets above the 6% yield threshold",
      "sources": [{ "name": "MarketTape", "ref": "live-price-feed" }],
      "durationMs": 1100
    },
    {
      "id": "retrieve",
      "kind": "retrieve",
      "label": "Pulling risk, liquidity, and jurisdiction data for candidates",
