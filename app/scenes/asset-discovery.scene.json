    "find conservative yield opportunities",
    "high yield conservative assets",
    "yield screen"
  ],
  "thinking": [
    {
      "id": "plan",
      "kind": "plan",
      "label": "Parsing mandate constraints — yield floor, conservative risk tolerance",
      "durationMs": 900
