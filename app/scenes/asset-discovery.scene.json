      },
      {
        "id": "candidate-comparison-node",
        "type": "comparison",
        "reveal": 7,
        "props": { "title": "Candidates compared" },
        "bind": { "data": "candidate-comparison-table" }
      },
      {
        "id": "yield-trend-panel",
        "type": "panel",
        "reveal": 8,
        "props": { "title": "90-day yield vs. volatility" },
        "children": [
          {
            "id": "aldergate-estates-trend",
            "type": "time-series",
            "reveal": 9,
            "props": { "title": "Aldergate Estates" },
            "bind": { "data": "aldergate-estates-series" }
          },
          {
            "id": "vantara-metals-trend",
            "type": "time-series",
            "reveal": 10,
            "props": { "title": "Vantara Metals" },
            "bind": { "data": "vantara-metals-series" }
          },
          {
            "id": "helios-yield-fund-trend",
            "type": "time-series",
            "reveal": 11,
            "props": { "title": "Helios Yield Fund" },
            "bind": { "data": "helios-yield-fund-series" }
          },
          {
            "id": "nordbond-2029-trend",
            "type": "time-series",
            "reveal": 12,
            "props": { "title": "NordBond 2029 (reference)" },
            "bind": { "data": "nordbond-2029-series" }
          }
        ]
      },
      {
        "id": "asset-discovery-findings",
        "type": "text-block",
        "reveal": 13,
        "props": {
          "text": "Helios's yield is real, but its RiskLens score of 61 and retail concentration sit outside the conservative mandate cited from PortfolioAtlas.\n\nNordBond remains the reference point — 5.8%, just below the 6% threshold."
        }
      },
      {
        "id": "asset-discovery-recommendation",
        "type": "recommendation",
        "reveal": 14,
        "props": {
          "text": "Aldergate Estates fits the conservative mandate best, pending its audit renewal. Vantara stands as the portfolio's diversifier.",
          "confidence": 0.74,
          "caveat": "Aldergate's audit renewal is still pending — size the position accordingly."
        }
      }
    ]
  }
