        "id": "summary-metrics",
        "type": "metric-grid",
        "reveal": 1,
        "children": [
          {
            "id": "candidates-found",
            "type": "metric",
            "reveal": 2,
            "props": { "label": "Candidates above 6%", "value": 3, "unit": "assets" }
          },
          {
            "id": "reference-asset",
            "type": "metric",
            "reveal": 3,
            "props": { "label": "Reference — NordBond 2029", "value": "5.8%", "detail": "Below threshold" }
          },
          {
            "id": "top-yield",
            "type": "metric",
            "reveal": 4,
            "props": { "label": "Highest yield", "value": "9.1%", "detail": "Helios Yield Fund" }
          }
        ]
      },
      {
        "id": "ranked-assets-panel",
        "type": "panel",
        "reveal": 5,
        "props": { "title": "Candidates ranked by yield" },
